{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test",
        "typecheck": "tsc -b",
        "codegen:markets": "python ../backend/export_openapi.py && npx openapi-typescript ../backend/openapi.generated.json -o src/types/api.generated.ts && python -m bet_framework.markets.contract src/test/fixtures/markets-contract.snapshot.json",
        "codegen:markets:check": "python ../backend/export_openapi.py /tmp/openapi.check.json && python -m bet_framework.markets.contract /tmp/snapshot.check.json && diff -q /tmp/openapi.check.json ../backend/openapi.generated.json && npx openapi-typescript ../backend/openapi.generated.json -o /tmp/api.check.ts && diff -q /tmp/api.check.ts src/types/api.generated.ts && diff -q /tmp/snapshot.check.json src/test/fixtures/markets-contract.snapshot.json && echo 'market contract artifacts in sync'"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "@mui/x-date-pickers": "^9.2.0",
        "axios": "^1.14.0",
        "dayjs": "^1.11.20",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.14.0",
        "recharts": "^3.8.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "@vitest/ui": "^5.0.1",
        "autoprefixer": "^10.4.27",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "jsdom": "^30.1.1",
        "msw": "^2.15.0",
        "openapi-typescript": "^6.7.6",
        "postcss": "^8.5.8",
        "tailwindcss": "^3.4.19",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.4",
        "vitest": "^5.0.1"
    }
}
