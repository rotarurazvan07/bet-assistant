@@ -0,0 +1,73 @@
+rules:
+  - id: no-raw-market-key-literals
+    message: |
+      Raw canonical market key/type string literal detected.
+
+      Market keys/types must be referenced via bet_framework/markets/ (enums.py,
+      catalog.py MarketSpec, keys.py helpers). This rule runs in BASELINE mode:
+      pre-existing findings are grandfathered in .semgrep/baseline.json (ratchet:
+      the baseline may only shrink), and any NEW occurrence, or any occurrence
+      inside bet_framework/markets/ itself (must import, never redeclare),
+      fails the gate.
+    severity: ERROR
+    languages: [python, ts]
+    paths:
+      exclude:
+        - bet_framework/markets/*
+        - .semgrep/*
+    patterns:
+      - pattern-either:
+          - pattern: "cons_home"
+          - pattern: "cons_draw"
+          - pattern: "cons_away"
+          - pattern: "cons_over_25"
+          - pattern: "cons_under_25"
+          - pattern: "cons_btts_yes"
+          - pattern: "cons_btts_no"
