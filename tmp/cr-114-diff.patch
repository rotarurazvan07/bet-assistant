index 0000000..dd9e478
--- /dev/null
+++ b/bet_dashboard/frontend/src/test/marketsContract.test.ts
@@ -0,0 +1,42 @@
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { MARKET_COLUMNS } from '../config/marketConfig';
+
+/**
+ * AC-01 frontend parity: the hand-duplicated frontend catalog must match the
+ * canonical Python snapshot. This is the test that would have caught the
+ * PR #106 `btts_y` vs `btts_yes` divergence class.
+ *
+ * The fixture is generated by `python -m bet_framework.markets.contract <path>`
+ * and its freshness is enforced from the Python side
+ * (tests/test_markets_contract.py asserts emit() == MARKET_CATALOG), keeping
+ * Python the single source of truth.
+ */
+
+type SnapshotRow = { label: string; market_type: string; cons_key: string; odds_key: string };
+
+function loadSnapshot(): Record<string, SnapshotRow> {
+  // vitest cwd is the frontend package root; the fixture is generated from the
+  // canonical Python emitter (see module docstring above).
+  const fixturePath = resolve(process.cwd(), 'src/test/fixtures/markets-contract.snapshot.json');
+  return JSON.parse(readFileSync(fixturePath, 'utf-8')) as Record<string, SnapshotRow>;
+}
+
+describe('frontend market catalog matches canonical Python snapshot', () => {
+  const rows = loadSnapshot();
+
+  it('covers exactly the canonical market set', () => {
+    expect(Object.keys(rows).sort()).toEqual(MARKET_COLUMNS.map((c) => c.market).sort());
+  });
+
+  it('matches market type and column keys for every row', () => {
+    for (const column of MARKET_COLUMNS) {
+      const row = rows[column.market];
+      expect(row, `missing canonical row for ${column.market}`).toBeDefined();
+      expect(column.marketType).toBe(row.market_type);
+      expect(column.consKey).toBe(row.cons_key);
+      expect(column.oddsKey).toBe(row.odds_key);
+    }
+  });
+});
