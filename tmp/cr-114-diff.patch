+          - pattern: "cons_under_15"
+          - pattern: "cons_over_35"
+          - pattern: "cons_under_35"
+          - pattern: "cons_over_45"
+          - pattern: "cons_under_45"
+          - pattern: "cons_dc_1x"
+          - pattern: "cons_dc_12"
+          - pattern: "cons_dc_x2"
+          - pattern: "odds_home"
+          - pattern: "odds_draw"
+          - pattern: "odds_away"
+          - pattern: "odds_over_25"
+          - pattern: "odds_under_25"
+          - pattern: "odds_btts_yes"
+          - pattern: "odds_btts_no"
+          - pattern: "odds_over_05"
+          - pattern: "odds_under_05"
+          - pattern: "odds_over_15"
+          - pattern: "odds_under_15"
+          - pattern: "odds_over_35"
+          - pattern: "odds_under_35"
+          - pattern: "odds_over_45"
+          - pattern: "odds_under_45"
+          - pattern: "odds_dc_1x"
+          - pattern: "odds_dc_12"
+          - pattern: "odds_dc_x2"
+          - pattern: "'BTTS Yes'"
+          - pattern: "'BTTS No'"
